# URL et clé de ton projet Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret utilisé pour signer la session Express (mets une longue chaîne aléatoire)
SESSION_SECRET=change-moi-avec-une-chaine-longue-et-aleatoire

# Port du serveur (optionnel, 3000 par défaut)
PORT=3000
