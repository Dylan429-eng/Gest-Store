<%- include('partials/shell-start') %>

<div class="mb-6">
  <h1 class="font-display text-2xl md:text-3xl font-semibold stitch inline-block">Dépenses</h1>
  <p class="text-sm text-muted mt-3">Note chaque sortie d'argent : nourriture, transport, loyer, imprévus...</p>
</div>

<div class="grid lg:grid-cols-3 gap-5">

  <!-- ===== Formulaire ===== -->
  <div class="lg:col-span-1">
    <div class="bg-surface rounded-xl p-5 shadow-sm border border-black/5 lg:sticky lg:top-6">
      <h2 class="font-display text-lg font-semibold mb-4"><i class="fa-solid fa-plus text-gold mr-1.5"></i>Nouvelle dépense</h2>
      <form action="/depenses" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Libellé</label>
          <input type="text" name="libelle" required placeholder="Ex : Nourriture midi, Transport..."
            class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:border-gold focus:ring-1 focus:ring-gold outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Montant</label>
          <input type="number" step="0.01" min="0" name="montant" required placeholder="0"
            class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm font-mono-fig focus:border-gold focus:ring-1 focus:ring-gold outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Date</label>
          <input type="date" name="date_depense"
            class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:border-gold focus:ring-1 focus:ring-gold outline-none" />
        </div>
        <button type="submit"
          class="w-full bg-ink text-white rounded-lg py-2.5 text-sm font-semibold hover:bg-ink/90 transition-colors">
          Enregistrer la dépense
        </button>
      </form>
    </div>
  </div>

  <!-- ===== Tableau ===== -->
  <div class="lg:col-span-2">
    <div class="bg-surface rounded-xl shadow-sm border border-black/5 overflow-hidden">
      <% if (depenses.length === 0) { %>
        <p class="text-sm text-muted p-6 text-center"><i class="fa-regular fa-face-smile mr-1.5"></i>Aucune dépense enregistrée pour l'instant.</p>
      <% } else { %>

        <table class="w-full text-sm hidden md:table">
          <thead>
            <tr class="text-left text-xs text-muted uppercase tracking-wide border-b border-black/5">
              <th class="px-5 py-3 font-medium">Libellé</th>
              <th class="px-5 py-3 font-medium">Date</th>
              <th class="px-5 py-3 font-medium text-right">Montant</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/5">
            <% depenses.forEach(d => { %>
              <tr>
                <td class="px-5 py-3 font-medium"><%= d.libelle %></td>
                <td class="px-5 py-3 text-muted"><%= new Date(d.date_depense).toLocaleDateString('fr-FR') %></td>
                <td class="px-5 py-3 text-right font-mono-fig font-semibold text-rust">-<%= Number(d.montant).toLocaleString('fr-FR') %></td>
                <td class="px-5 py-3 text-right">
                  <form action="/depenses/<%= d.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Supprimer cette dépense ?');">
                    <button type="submit" class="text-muted hover:text-rust" aria-label="Supprimer">
                      <i class="fa-regular fa-trash-can"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <ul class="md:hidden divide-y divide-black/5">
          <% depenses.forEach(d => { %>
            <li class="p-4 flex items-center justify-between">
              <div>
                <p class="font-medium text-sm"><%= d.libelle %></p>
                <p class="text-xs text-muted mt-0.5"><%= new Date(d.date_depense).toLocaleDateString('fr-FR') %></p>
              </div>
              <div class="flex items-center gap-3">
                <p class="font-mono-fig text-sm font-semibold text-rust">-<%= Number(d.montant).toLocaleString('fr-FR') %> F</p>
                <form action="/depenses/<%= d.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Supprimer cette dépense ?');">
                  <button type="submit" class="text-muted hover:text-rust p-1" aria-label="Supprimer">
                    <i class="fa-regular fa-trash-can"></i>
                  </button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>

      <% } %>
    </div>
  </div>
</div>

<%- include('partials/shell-end') %>
