<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %> · Boutique</title>

<!-- PWA : manifest, icônes, couleur de thème -->
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#171B26" />
<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Atelier" />

<!-- Polices : Fraunces (titres, caractère) / Inter (texte) / IBM Plex Mono (chiffres) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
  rel="stylesheet"
/>

<!-- Font Awesome -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
/>

<!-- Tailwind (CDN, sans étape de build) -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          // Format "rgb(r g b / <alpha-value>)" requis par Tailwind pour que
          // les modificateurs d'opacité (ex: bg-ink/98) génèrent bien un fond,
          // au lieu de rester transparents avec un hex simple.
          ink: 'rgb(23 27 38 / <alpha-value>)',
          paper: '#EEF1EF',
          surface: '#FFFFFF',
          muted: '#6B7280',
          gold: 'rgb(201 153 43 / <alpha-value>)',
          emerald: 'rgb(47 143 107 / <alpha-value>)',
          rust: 'rgb(193 82 58 / <alpha-value>)',
        },
        fontFamily: {
          display: ['"Fraunces"', 'serif'],
          sans: ['"Inter"', 'sans-serif'],
          mono: ['"IBM Plex Mono"', 'monospace'],
        },
      },
    },
  };
</script>

<!-- Chart.js pour la courbe de performance -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<link rel="stylesheet" href="/css/style.css" />

<!-- Enregistrement du service worker (mode hors-ligne + installation PWA) -->
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch((err) => {
        console.warn('Service worker non enregistré :', err);
      });
    });
  }
</script>
